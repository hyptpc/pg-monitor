#!/usr/bin/env python3

import argparse
import psycopg2
from psycopg2 import sql

from myenv import db_config, get_logger

if __name__ == '__main__':
  parser = argparse.ArgumentParser(
    description='Get latest value from PostgreSQL table.')
  parser.add_argument('table', help='Table name')
  parser.add_argument('column', help='Column name to retrieve')
  parser.add_argument('-t', '--with-time', action='store_true',
                      help='Include timestamp in output')
  args = parser.parse_args()

  conn = psycopg2.connect(**db_config)
  cur = conn.cursor()
  fields = [sql.Identifier(args.column)]
  if args.with_time:
    fields.append(sql.Identifier('timestamp'))
  query = sql.SQL('SELECT {fields} FROM {table} ORDER BY timestamp DESC LIMIT 1').format(
      fields=sql.SQL(', ').join(fields),
      table=sql.Identifier(args.table)
  )
  cur.execute(query)
  row = cur.fetchone()
  if row:
    if args.with_time:
      print(f'{row[0]} (timestamp: {row[1]})')
    else:
      print(row[0])
  else:
    print('No data found.')
  cur.close()
  conn.close()
