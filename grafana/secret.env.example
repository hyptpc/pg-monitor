# Copy to secret.env (gitignored, chmod 600) and fill in before restore.
# contact point 'Discord alert' url
CP_DISCORD_ALERT_URL=
# contact point 'email receiver' addresses
CP_EMAIL_RECEIVER_ADDRESSES=
# datasource 'grafana-postgresql-datasource' password
DS_GRAFANA_POSTGRESQL_DATASOURCE_PASSWORD=
# datasource 'netdatacloud-netdata-datasource' apiToken
DS_NETDATACLOUD_NETDATA_DATASOURCE_APITOKEN=
