            "rawQuery": true,
            "rawSql": "SELECT\n  time_bucket('5 minute', timestamp) AS minute,\n  avg(ia_tcx01) AS \"UCbobbin\",\n  avg(ia_tcx02) AS \"BCbobbin\",\n  avg(ia_tcx03) AS \"HTS-U\",\n  avg(ia_tcx04) AS \"HTS-B\",\n  avg(ia_tcx05) AS \"CH#1-2\",\n  avg(ia_tcx06) AS \"CH#2-2\",\n  avg(ia_tcx07) AS \"CH#1-1\",\n  avg(ia_tcx08) AS \"CH#2-1\",\n--  avg(ia_tsd09) AS ia_tsd09,\n--  avg(ia_tsd10) AS ia_tsd10,\n--  avg(ia_tsd11) AS ia_tsd11,\n--  avg(ia_tsd12) AS ia_tsd12,\n--  avg(ai_tcc13) AS ai_tcc13,\n--  avg(ai_tcc14) AS ai_tcc14,\n--  avg(ai_tcc15) AS ai_tcc15,\n--  avg(ai_tcc16) AS ai_tcc16,\n--  avg(ai_tcc17) AS ai_tcc17,\n--  avg(ai_tcc18) AS ai_tcc18,\n--  avg(ai_tcc19) AS ai_tcc19,\n--  avg(ai_tcc20) AS ai_tcc20,\n  avg(ai_ci_ps) AS \"Ishunt\",\n--  avg(ai_v_hall) AS ai_v_hall\n  avg(ia_v_hall) AS \"Ihall\"\nFROM\n  shs\nWHERE\n  timestamp BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY\n  minute\nORDER BY\n  minute",
