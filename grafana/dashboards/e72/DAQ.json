            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT t.name AS \"Trigger\",\n  regexp_replace(t.cond, 'x', ' × ', 'g') AS \"Condition\",\n  t.ps + 1 AS \"Prescale\",\n  (r.rgn3_sel_psor >> t.i) & 1 AS \"PS-OR\",\n  t.gate AS \"Gate\"\nFROM (SELECT * FROM trigger ORDER BY timestamp DESC LIMIT 1) r,\nLATERAL (VALUES\n  ('A', r.trig_a, r.rgn3_ps_r2a, 0, r.rgn3_gate_r2a), ('B', r.trig_b, r.rgn3_ps_r2b, 1, r.rgn3_gate_r2b),\n  ('C', r.trig_c, r.rgn3_ps_r2c, 2, r.rgn3_gate_r2c), ('D', r.trig_d, r.rgn3_ps_r2d, 3, r.rgn3_gate_r2d),\n  ('E', r.trig_e, r.rgn3_ps_r2e, 4, r.rgn3_gate_r2e), ('F', r.trig_f, r.rgn3_ps_r2f, 5, r.rgn3_gate_r2f)\n) AS t(name, cond, ps, i, gate)\nORDER BY t.name",
            "refId": "A"
          }
        ],
        "title": "Trigger setting",
        "type": "table"
