        },
        "targets": [
          {
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "deiuvse1meygwe"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT CASE WHEN count(i) = 0 THEN 'none'\n  WHEN count(i) = max(i) - min(i) + 1 THEN format('seg %s–%s', min(i) + 1, max(i) + 1)\n  ELSE 'seg ' || string_agg((i + 1)::text, ',' ORDER BY i) END || format(' (%s)', max(v)) AS sel\nFROM (SELECT rgn1_sel_tof AS v FROM trigger ORDER BY timestamp DESC LIMIT 1) r\nLEFT JOIN generate_series(0, 23) i ON (r.v >> i) & 1 = 1",
            "refId": "A"
          }
        ],
        "title": "Selector (BH2)",
        "type": "stat"
