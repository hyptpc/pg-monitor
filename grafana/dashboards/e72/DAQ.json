            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT coalesce(nullif(concat_ws(' + ',\n  CASE WHEN rgn4_sel_extclk = 1 THEN 'External' END,\n  CASE WHEN rgn4_sel_clk10m = 1 THEN '10 MHz' END,\n  CASE WHEN rgn4_sel_clk1m = 1 THEN '1 MHz' END,\n  CASE WHEN rgn4_sel_clk100k = 1 THEN '100 kHz' END,\n  CASE WHEN rgn4_sel_clk10k = 1 THEN '10 kHz' END,\n  CASE WHEN rgn4_sel_clk1k = 1 THEN '1 kHz' END,\n  CASE WHEN rgn4_sel_rsv2 = 1 THEN 'Reserve2' END), ''), 'none') AS clock\nFROM trigger ORDER BY timestamp DESC LIMIT 1",
            "refId": "A"
          }
        ],
        "title": "Clock",
        "type": "stat"
