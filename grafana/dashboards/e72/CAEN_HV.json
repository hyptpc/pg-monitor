        "targets": [
          {
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "deiuvse1meygwe"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT\n  ip_address AS \"Crate\", board_slot AS \"Slot\", split_part(board_name, ' ', 1) AS \"Board\", channel AS \"Ch\",\n  channel_name AS \"Name\", pw::int AS \"Pw\",\n  v0set AS \"V0Set\", vmon AS \"VMon\", CASE WHEN pw THEN vmon - v0set END AS \"ΔV\",\n  i0set AS \"I0Set\", imon AS \"IMon\", CASE WHEN pw AND i0set > 0 THEN imon / i0set * 100 END AS \"I/I0Set\",\n  CASE WHEN s & 61432 > 0 THEN 2 WHEN s & 6 > 0 THEN 1 ELSE 0 END AS \"Sev\",\n  concat_ws(' ', CASE WHEN s & 2 > 0 THEN 'RampUp' END, CASE WHEN s & 4 > 0 THEN 'RampDown' END, CASE WHEN s & 8 > 0 THEN 'OverCurrent' END, CASE WHEN s & 16 > 0 THEN 'OverVoltage' END, CASE WHEN s & 32 > 0 THEN 'UnderVoltage' END, CASE WHEN s & 64 > 0 THEN 'ExtTrip' END, CASE WHEN s & 128 > 0 THEN 'MaxV' END, CASE WHEN s & 256 > 0 THEN 'ExtDisabled' END, CASE WHEN s & 512 > 0 THEN 'IntTrip' END, CASE WHEN s & 1024 > 0 THEN 'CalibErr' END, CASE WHEN s & 2048 > 0 THEN 'Unplugged' END, CASE WHEN s & 8192 > 0 THEN 'OVProtection' END, CASE WHEN s & 16384 > 0 THEN 'PowerFail' END, CASE WHEN s & 32768 > 0 THEN 'TempError' END) AS \"Status\"\nFROM (SELECT *, channel_status::int AS s FROM (SELECT DISTINCT ON (ip_address, board_slot, channel) * FROM caenhv\n  WHERE timestamp > now() - interval '2 minutes' ORDER BY ip_address, board_slot, channel, timestamp DESC) l) l\nWHERE ip_address IN (${crate:sqlstring}) AND (${unused} = 1 OR channel_name <> 'n/a' AND channel_name !~ '^CHANNEL[0-9]+$')\nORDER BY 1, 2, 4",
            "refId": "A"
          }
        ],
        "title": "Channels (latest)",
        "type": "table"
