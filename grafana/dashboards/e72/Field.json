        },
        "description": "Seconds since the last row from each hall probe. Orange > 30 s, red > 120 s or no data for 7 days.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 0,
            "mappings": [
              {
                "options": {
                  "match": "null",
                  "result": {
                    "color": "red",
                    "index": 0,
                    "text": "stopped"
                  }
                },
                "type": "special"
              }
            ],
            "noValue": "stopped",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 30
                },
                {
                  "color": "red",
                  "value": 120
                }
              ]
            },
            "unit": "s"
          },
          "overrides": []
