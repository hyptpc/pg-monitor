        },
        "targets": [
          {
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "deiuvse1meygwe"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT EXTRACT(EPOCH FROM now() - (SELECT max(timestamp) FROM field WHERE name = 'shs1' AND timestamp > now() - interval '7 days')) AS \"SHS1\", EXTRACT(EPOCH FROM now() - (SELECT max(timestamp) FROM field WHERE name = 'shs2' AND timestamp > now() - interval '7 days')) AS \"SHS2\", EXTRACT(EPOCH FROM now() - (SELECT max(timestamp) FROM field WHERE name = 'd5' AND timestamp > now() - interval '7 days')) AS \"D5\"",
            "refId": "A"
          }
        ],
        "title": "Probe data age",
        "type": "stat"
