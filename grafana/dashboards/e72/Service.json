            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "WITH l AS (\n  SELECT DISTINCT ON (name) timestamp, replace(name, 'pg-updater@', '') AS name, status,\n         regexp_replace(last_log, '^\\w{3} +\\d+ [0-9:]+ \\S+ \\S+: ', '') AS msg,\n         substring(last_log from '^\\w{3} +\\d+ [0-9:]+') AS logtime\n  FROM service WHERE timestamp > now() - interval '10 minutes'\n  ORDER BY name, timestamp DESC)\nSELECT count(*) FILTER (WHERE status = 'active') || ' / ' || count(*) FROM l",
            "refId": "A"
          }
        ],
        "title": "Active",
        "type": "stat"
