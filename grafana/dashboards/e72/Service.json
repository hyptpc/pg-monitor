            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "WITH l AS (\n  SELECT DISTINCT ON (name) timestamp, replace(name, 'pg-updater@', '') AS name, status,\n         regexp_replace(last_log, '^\\w{3} +\\d+ [0-9:]+ \\S+ \\S+: ', '') AS msg,\n         substring(last_log from '^\\w{3} +\\d+ [0-9:]+') AS logtime\n  FROM service WHERE timestamp > now() - interval '10 minutes'\n  ORDER BY name, timestamp DESC)\nSELECT\n  name AS \"Service\",\n  CASE status WHEN 'active' THEN 0 WHEN 'inactive' THEN 1 WHEN 'failed' THEN 2 ELSE 3 END AS \"Status\",\n  CASE WHEN msg ~ '\\[ERROR\\]' THEN 'ERROR' WHEN msg ~ '\\[WARNING\\]' THEN 'WARNING'\n       WHEN msg ~ '\\[INFO\\]' THEN 'INFO' ELSE '' END AS \"Level\",\n  logtime AS \"Log time\",\n  regexp_replace(msg, '^\\([^)]*\\) \\[\\w+\\] ', '') AS \"Last log line\"\nFROM l\nORDER BY CASE WHEN status <> 'active' THEN 0 WHEN msg ~ '\\[ERROR\\]' THEN 1 WHEN msg ~ '\\[WARNING\\]' THEN 2 ELSE 3 END, name",
            "refId": "A"
          }
        ],
        "title": "Services",
        "type": "table"
