        "targets": [
          {
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "deiuvse1meygwe"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT\n  controller AS \"Controller\", port AS \"Port\", hvon::int AS \"HV\",\n  vmon AS \"Vmon\", imon AS \"Imon\",\n  CASE WHEN temp_in_range THEN temp END AS \"Temp\",\n  CASE WHEN overcurrent THEN 2 WHEN current_out_of_spec THEN 1 ELSE 0 END AS \"Alarm\",\n  EXTRACT(EPOCH FROM now() - timestamp) AS \"Age\"\nFROM (SELECT DISTINCT ON (controller, port) * FROM mppchv\n      WHERE timestamp > now() - interval '1 day' AND controller IN (${controller:sqlstring})\n      ORDER BY controller, port, timestamp DESC) l\nORDER BY 1, 2",
            "refId": "A"
          }
        ],
        "title": "Channels (latest)",
        "type": "table"
