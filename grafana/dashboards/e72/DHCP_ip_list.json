            "rawQuery": true,
            "rawSql": "WITH RECURSIVE k AS (\n  (SELECT ip_address, interface FROM dhcp ORDER BY ip_address, interface LIMIT 1)\n  UNION ALL\n  SELECT n.ip_address, n.interface FROM k, LATERAL (\n    SELECT ip_address, interface FROM dhcp d WHERE (d.ip_address, d.interface) > (k.ip_address, k.interface)\n    ORDER BY ip_address, interface LIMIT 1) n\n), l AS (\n  SELECT d.*, (d.status AND d.timestamp > now() - interval '25 minutes')::int AS online\n  FROM k, LATERAL (SELECT * FROM dhcp d WHERE d.ip_address = k.ip_address AND d.interface = k.interface\n                   ORDER BY timestamp DESC LIMIT 1) d\n)\nSELECT\n  online AS \"State\",\n  host(ip_address) AS \"IP\",\n  hostname AS \"Hostname\",\n  domain AS \"Domain\",\n  vendor AS \"Vendor\",\n  mac_address AS \"MAC\",\n  interface AS \"Interface\",\n  timestamp AS \"Last seen\"\nFROM l\nORDER BY online DESC, ip_address",
