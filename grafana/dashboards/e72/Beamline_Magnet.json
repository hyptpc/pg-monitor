        "targets": [
          {
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "deiuvse1meygwe"
            },
            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT\n  m.key AS \"Magnet\",\n  CASE WHEN abs((m.value->>'cset')::float) > 1 THEN 1 ELSE 0 END AS \"State\",\n  (m.value->>'cset')::float AS \"Set\",\n  (m.value->>'cmon')::float AS \"Mon\",\n  m.value->>'pol' AS \"Pol\",\n  CASE WHEN abs((m.value->>'cset')::float) > 1 THEN (abs((m.value->>'cmon')::float) - abs((m.value->>'cset')::float)) / abs((m.value->>'cset')::float) * 100 END AS \"Dev\"\nFROM (SELECT timestamp, magnet_data FROM magnet ORDER BY timestamp DESC LIMIT 1) l, LATERAL jsonb_each(l.magnet_data) AS m(key, value)\nORDER BY CASE m.key WHEN 'AK11D1' THEN 0 WHEN 'AK18D1' THEN 1 WHEN 'AH18' THEN 2 WHEN 'BSM1' THEN 3 WHEN 'K18Q1' THEN 4 WHEN 'K18Q2' THEN 5 WHEN 'K18D2' THEN 6 WHEN 'K18Q3' THEN 7 WHEN 'K18O1' THEN 8 WHEN 'K18Q4' THEN 9 WHEN 'K18S1' THEN 10 WHEN 'K18CM1' THEN 11 WHEN 'K18CM2' THEN 12 WHEN 'K18S2' THEN 13 WHEN 'K18Q5' THEN 14 WHEN 'K18Q6' THEN 15 WHEN 'K18D3' THEN 16 WHEN 'K18BRS3' THEN 17 WHEN 'K18BRQ7' THEN 18 WHEN 'K18BRD4' THEN 19 WHEN 'K18BRQ8' THEN 20 WHEN 'K18BRD5' THEN 21 WHEN 'DORA' THEN 22 ELSE 999 END",
